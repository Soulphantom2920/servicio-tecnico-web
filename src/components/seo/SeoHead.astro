---
import { isIndexableProduction, siteConfig } from '@/config/siteConfig';

interface Props {
  title: string;
  description: string;
  pathname: string;
  noindex?: boolean;
}

const { title, description, pathname, noindex = false } = Astro.props;
const pageTitle = `${title} | ${siteConfig.siteName}`;
const canIndex = isIndexableProduction && !noindex;
const canonicalUrl = canIndex && siteConfig.siteUrl ? new URL(pathname, siteConfig.siteUrl) : null;
const ogImageUrl = canonicalUrl
  ? new URL(siteConfig.ogImagePath, canonicalUrl.origin).toString()
  : null;
const robotsContent = canIndex
  ? 'index, follow, max-image-preview:large'
  : 'noindex, nofollow, noarchive, nosnippet, noimageindex';
const faviconSizes = [16, 32, 48, 64, 180, 192, 512] as const;
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={robotsContent} />
<meta name="color-scheme" content="light dark" />
{!siteConfig.identityIsPlaceholder && <meta name="author" content={siteConfig.ownerName} />}
{
  faviconSizes.map((size) => (
    <link
      rel="icon"
      type="image/png"
      sizes={`${size}x${size}`}
      href={siteConfig.brand.favicon.light[size]}
      media="(prefers-color-scheme: light)"
    />
  ))
}

{
  faviconSizes.map((size) => (
    <link
      rel="icon"
      type="image/png"
      sizes={`${size}x${size}`}
      href={siteConfig.brand.favicon.dark[size]}
      media="(prefers-color-scheme: dark)"
    />
  ))
}

<link rel="apple-touch-icon" sizes="180x180" href={siteConfig.brand.favicon.dark[180]} />

{canonicalUrl && <link rel="canonical" href={canonicalUrl.toString()} />}

<meta property="og:type" content="website" />
<meta property="og:locale" content="es_CR" />
<meta property="og:site_name" content={siteConfig.siteName} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
{canonicalUrl && <meta property="og:url" content={canonicalUrl.toString()} />}
{ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
{ogImageUrl && <meta property="og:image:type" content="image/png" />}
{ogImageUrl && <meta property="og:image:width" content="1200" />}
{ogImageUrl && <meta property="og:image:height" content="630" />}
{ogImageUrl && <meta property="og:image:alt" content={siteConfig.ogImageAlt} />}

<meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
{ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
{ogImageUrl && <meta name="twitter:image:alt" content={siteConfig.ogImageAlt} />}
