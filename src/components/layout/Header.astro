---
import WhatsAppLink from '@/components/ui/WhatsAppLink.astro';
import { siteConfig } from '@/config/siteConfig';
import { content } from '@/data/content';
---

<header class="site-header">
  <div class="site-header__inner page-shell">
    <a class="site-brand" href="/" aria-label={`${siteConfig.siteName}, inicio`}>
      <picture class="site-brand__visual">
        <source
          srcset={siteConfig.brand.symbol.dark.svg}
          media="(max-width: 25rem) and (prefers-color-scheme: dark)"
        />
        <source srcset={siteConfig.brand.symbol.light.svg} media="(max-width: 25rem)" />
        <source srcset={siteConfig.brand.logo.dark} media="(prefers-color-scheme: dark)" />
        <img src={siteConfig.brand.logo.light} alt="" width="2400" height="414" />
      </picture>
    </a>

    <nav class="site-nav" aria-label="Navegación principal">
      <a href="/#servicios">{content.navigation.services}</a>
      <a href="/#proceso">{content.navigation.process}</a>
      <a href="/#sobre-el-servicio">{content.navigation.trust}</a>
    </nav>

    <WhatsAppLink
      label={content.navigation.contact}
      message={content.finalCta.message}
      accessibleLabel="Contactar por WhatsApp"
    />
  </div>
</header>

<style>
  .site-header {
    border-block-end: var(--border-width) solid var(--color-border);
    background: color-mix(in srgb, var(--color-background) 94%, transparent);
  }

  .site-header__inner {
    display: grid;
    min-height: var(--header-height);
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
  }

  .site-brand {
    display: inline-flex;
    width: fit-content;
    min-width: 0;
    min-height: var(--control-min-size);
    align-items: center;
    border-radius: var(--radius-sm);
    text-decoration: none;
  }

  .site-brand__visual {
    display: block;
    width: 13rem;
    aspect-ratio: 2400 / 414;
  }

  .site-brand__visual img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .site-nav {
    display: none;
    align-items: center;
    gap: var(--space-5);
  }

  .site-nav a {
    min-height: var(--control-min-size);
    align-content: center;
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
  }

  .site-nav a:hover {
    color: var(--color-text);
  }

  @media (min-width: 58rem) {
    .site-header__inner {
      grid-template-columns: minmax(12rem, 1fr) auto minmax(12rem, 1fr);
    }

    .site-nav {
      display: flex;
    }

    .site-header :global(.whatsapp-link) {
      justify-self: end;
    }
  }

  @media (max-width: 25rem) {
    .site-brand__visual {
      width: 2.5rem;
      aspect-ratio: 473.42316 / 516.27679;
    }

    .site-header :global(.whatsapp-link) {
      padding-inline: var(--space-3);
    }
  }
</style>
